      "content": "languagesystem DFLT dflt;\nlanguagesystem latn dflt;\nlanguagesystem latn TRK;\nmarkClass acutecomb <anchor 0 0> @TOP;\nmarkClass dotcomb <anchor 0 0> @TOP;\nfeature liga {\nsub f i by f_i;\n} liga;\nfeature ss01 {\nsub A by A.alt;\n} ss01;\nfeature salt {\nsub A from [A.alt];\n} salt;\nfeature calt {\nlookupflag IgnoreMarks; sub A A' by A.alt;\n} calt;\nfeature tnum {\nsub zero by zero.tnum;\n} tnum;\nfeature locl {\nscript latn; language TRK; sub i by i.trk;\n} locl;\nfeature kern {\npos A A -80;\n} kern;\nfeature mark {\npos base A <anchor 300 700> mark @TOP;\npos ligature f_i <anchor 250 700> mark @TOP ligComponent <anchor 700 700> mark @TOP;\n} mark;\nfeature mkmk {\npos mark acutecomb <anchor 0 150> mark @TOP;\n} mkmk;\nfeature curs {\npos cursive u <anchor 0 0> <anchor 400 100>; pos cursive n <anchor 0 0> <anchor 400 0>;\n} curs;\n",
