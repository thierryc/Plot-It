{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022"], "types": [], "rootDir": "src", "outDir": "dist",
    "declaration": true, "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true
  },
  "include": ["src"], "exclude": ["src/**/*.test.ts", "src/browser.ts", "src/node.ts"]
}
